{
  "info": {
    "name": "TCG CardHeaven",
    "description": "Colección end-to-end: registro con domicilio, login, catálogo, carrito, checkout y endpoints de admin. Las variables (tokens, ids) se guardan automáticamente entre requests via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "admin@tcgtrader.com" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "customerEmail", "value": "cust@test.com" },
    { "key": "customerPassword", "value": "cust123" },
    { "key": "adminRoleId", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "customerRoleId", "value": "00000000-0000-0000-0000-000000000002" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "adminId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "gameId", "value": "" },
    { "key": "setId", "value": "" },
    { "key": "cardId", "value": "" },
    { "key": "cardItemId", "value": "" },
    { "key": "deckId", "value": "" },
    { "key": "deckItemId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login admin (seeded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', b.token);",
                  "pm.collectionVariables.set('adminId', b.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Register customer (con domicilio inicial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('customerToken', b.token);",
                  "pm.collectionVariables.set('customerId', b.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Test\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"initialAddress\": {\n    \"street\": \"Calle Falsa 123\",\n    \"city\": \"Buenos Aires\",\n    \"country\": \"AR\",\n    \"zipCode\": \"1000\"\n  }\n}"
            }
          }
        },
        {
          "name": "Register customer (sin domicilio)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Addr\",\n  \"email\": \"noaddr@test.com\",\n  \"password\": \"pw123\"\n}"
            }
          }
        },
        {
          "name": "Login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('customerToken', b.token);",
                  "pm.collectionVariables.set('customerId', b.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          }
        }
      ]
    },
